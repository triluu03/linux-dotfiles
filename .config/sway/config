# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!
#
# This config file uses keycodes (bindsym) and was written for the QWERTY
# layout.
#
# To get a config file with the same key positions, but for your current
# layout, use the i3-config-wizard
#

# Set the variables in the beginning
set $up k
set $down j
set $left h
set $right l

set $mod Mod4


# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Ubuntu Sans 10

include ~/.config/sway/conf.d/autostart.conf
include ~/.config/sway/conf.d/input.conf

# Use wpctl to adjust volume in PipeWire.
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Layout configuration
gaps inner 10
default_border pixel 0
default_floating_border pixel 0

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
# Sway enables tiling drag by default (floating_modifier + titlebar),
# matching i3's "tiling_drag modifier titlebar".

include ~/.config/sway/conf.d/keybinding.conf
include ~/.config/sway/conf.d/mode.conf
